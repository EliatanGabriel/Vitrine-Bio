# Copie este arquivo para .env.local e substitua pelos valores reais.
# Número oficial do WhatsApp da Vitrine Bio — formato internacional, somente números.
# Exemplo: 5511999999999 (DDI 55 + DDD 11 + número). Não use espaços, parênteses ou traços.
NEXT_PUBLIC_WHATSAPP_NUMBER=5511000000000
# URL pública do site (usada em SEO, sitemap e Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.vitrinebio.com.br
